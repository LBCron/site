---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Search from './Search.astro';
import SocialLinks from './SocialLinks.astro';
---

<a href="#main-content" class="skip-link">Skip to content</a>
<header>
	<div class="bar">
		<a href="/" class="brand" aria-label={`${SITE_TITLE} home`}>
			<img src="/favicon.png" alt="" class="logo" width="40" height="40" />
			<span>{SITE_TITLE}</span>
		</a>
		<nav class="internal-links" aria-label="Primary">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
			<HeaderLink href="/training">Training</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</nav>
		<Search />
		<div class="tools">
			<button
				type="button"
				class="theme-toggle"
				data-theme-toggle
				aria-label="Toggle dark mode"
				title="Toggle dark mode"
			>
				<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" focusable="false">
					<path d="M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66l1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14l-1.41-1.41M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
				</svg>
				<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" focusable="false">
					<path fill="currentColor" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
				</svg>
			</button>
			<SocialLinks class="header-social" size={24} />
		</div>
	</div>
</header>
<script is:inline>
	(() => {
		const btn = document.querySelector('[data-theme-toggle]');
		if (!btn) return;
		const apply = (dark) => {
			document.documentElement.toggleAttribute('data-theme-set', true);
			if (dark) document.documentElement.setAttribute('data-theme', 'dark');
			else document.documentElement.removeAttribute('data-theme');
			btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
			const giscus = document.querySelector('iframe.giscus-frame');
			if (giscus) {
				giscus.contentWindow.postMessage(
					{ giscus: { setConfig: { theme: dark ? 'dark' : 'light' } } },
					'https://giscus.app',
				);
			}
		};
		apply(document.documentElement.getAttribute('data-theme') === 'dark');
		btn.addEventListener('click', () => {
			const next = document.documentElement.getAttribute('data-theme') !== 'dark';
			localStorage.setItem('theme', next ? 'dark' : 'light');
			apply(next);
		});
	})();
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgb(var(--surface));
		border-bottom: 1px solid rgb(var(--gray-light));
		box-shadow: 0 2px 8px rgba(var(--black), 4%);
		position: relative;
	}
	.bar {
		width: 1240px;
		max-width: 100%;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 64px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		color: rgb(var(--black));
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.15rem;
		text-decoration: none;
		white-space: nowrap;
		flex: 0 0 auto;
	}
	.brand:hover {
		text-decoration: none;
		color: var(--accent);
	}
	.logo {
		height: 2em;
		width: auto;
		display: block;
		border-radius: 8px;
	}
	[data-theme='dark'] .logo {
		filter: invert(1);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15em;
		flex: 1 1 auto;
		min-width: 0;
	}
	.internal-links :global(a) {
		padding: 1.15em 0.6em;
		color: rgb(var(--gray-dark));
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.98rem;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	.internal-links :global(a:hover) {
		text-decoration: none;
		color: var(--accent);
	}
	.internal-links :global(a.active) {
		font-weight: 700;
		color: rgb(var(--black));
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.tools {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex: 0 0 auto;
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		background: transparent;
		border: none;
		border-radius: 8px;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.theme-toggle:hover {
		background: rgb(var(--gray-light));
		color: var(--accent);
	}
	.theme-toggle .icon-moon {
		display: none;
	}
	[data-theme='dark'] .theme-toggle .icon-sun {
		display: none;
	}
	[data-theme='dark'] .theme-toggle .icon-moon {
		display: inline;
	}
	.bar > :global(#search) {
		flex: 0 0 auto;
		min-width: 0;
	}
	@media (max-width: 960px) {
		.bar {
			flex-wrap: wrap;
			gap: 0 1rem;
			padding: 0.5rem 0 0;
		}
		/* The search UI is injected after load. Giving it a row of its own
		   (flex-basis 100%) and a reserved min-height keeps the header the same
		   size before and after injection, so nothing below it shifts. */
		.bar > :global(#search) {
			order: 2;
			flex-basis: 100%;
			width: 100%;
			margin: 0.35rem 0 0.25rem;
		}
		.internal-links {
			order: 3;
			flex-basis: 100%;
			overflow-x: auto;
			scrollbar-width: none;
			-webkit-overflow-scrolling: touch;
			/* fade the right edge so it reads as scrollable */
			mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
			-webkit-mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
		}
		.internal-links::-webkit-scrollbar {
			display: none;
		}
		.internal-links :global(a) {
			padding: 0.75em 0.6em;
			white-space: nowrap;
		}
		.tools {
			margin-left: auto;
		}
	}
	@media (max-width: 720px) {
		.brand {
			font-size: 1.05rem;
		}
		.tools :global(.header-social li:not(:first-child)) {
			display: none;
		}
		.internal-links {
			justify-content: flex-start;
		}
	}
</style>
