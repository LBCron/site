---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { excerpt } from '../utils/excerpt';
import { minutesToRead, visibleTags } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

// One blog post as a card: share image, date and reading time, title,
// excerpt and up to four tags. Used by the home page, the blog index and
// the tag pages so a post looks the same wherever it is listed.
interface Props {
	post: CollectionEntry<'blog'>;
	image?: ImageMetadata | null;
	excerptLength?: number;
	sizes?: string;
	showTags?: boolean;
	headingLevel?: 'h2' | 'h3';
	loading?: 'lazy' | 'eager';
}

const {
	post,
	image = null,
	excerptLength = 150,
	sizes = '(max-width: 720px) 100vw, (max-width: 960px) 50vw, 350px',
	showTags = false,
	headingLevel = 'h3',
	loading = 'lazy',
} = Astro.props;

const Heading = headingLevel;
const tags = showTags ? visibleTags(post.data.tags).slice(0, 4) : [];
const blurb = excerpt(post.body, excerptLength) || post.data.description;
---

<a class="post-card" href={`/blog/${post.id}/`}>
	{image ? (
		<Image src={image} alt="" widths={[360, 540, 720]} sizes={sizes} loading={loading} />
	) : (
		<div class="ph" aria-hidden="true" />
	)}
	<div class="body">
		<p class="meta">
			<FormattedDate date={post.data.date} />
			<span class="dot" aria-hidden="true" />
			<span>{minutesToRead(post.body)} min read</span>
		</p>
		<Heading>{post.data.title}</Heading>
		<p class="desc">{blurb}</p>
		{tags.length > 0 && (
			<ul class="tags" aria-label="Tags">
				{tags.map((t) => (
					<li>{t}</li>
				))}
			</ul>
		)}
	</div>
</a>
<style>
	.post-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		box-sizing: border-box;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		overflow: hidden;
		background: rgb(var(--surface));
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}
	.post-card:hover {
		border-color: var(--accent);
		box-shadow: 0 18px 36px -24px rgba(35, 55, 255, 0.4);
		transform: translateY(-2px);
		text-decoration: none;
	}
	.post-card img,
	.ph {
		display: block;
		width: 100%;
		aspect-ratio: 1200 / 630;
		height: auto;
		object-fit: cover;
		object-position: left center;
		border-radius: 0;
	}
	.ph {
		background: linear-gradient(135deg, #0f1219, #1a2250 70%, #2337ff);
	}
	.body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1.25rem 1.35rem 1.4rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin: 0 0 0.6rem;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgb(var(--gray));
	}
	.dot::before {
		content: '\00b7';
	}
	h2,
	h3 {
		margin: 0 0 0.5rem;
		font-size: 1.2rem;
		line-height: 1.25;
		color: rgb(var(--black));
		transition: color 0.15s ease;
	}
	.post-card:hover h2,
	.post-card:hover h3 {
		color: var(--accent);
	}
	.desc {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 0.92rem;
		line-height: 1.5;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		list-style: none;
		margin: auto 0 0;
		padding: 0.9rem 0 0;
	}
	.tags li {
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.15rem 0.55rem;
		border: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		border-radius: 999px;
	}
</style>
