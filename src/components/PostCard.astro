---
import type { CollectionEntry } from 'astro:content';
import { excerpt } from '../utils/excerpt';
import { minutesToRead, visibleTags } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

// One blog post in a listing. Text first: the share images carry the
// title already, so repeating them next to the title said everything twice.
//   card  - a bordered tile for grids (home page recents)
//   row   - a full-width row with the date in a left column (blog, tags)
interface Props {
	post: CollectionEntry<'blog'>;
	variant?: 'card' | 'row';
	excerptLength?: number;
	showTags?: boolean;
	headingLevel?: 'h2' | 'h3';
}

const {
	post,
	variant = 'card',
	excerptLength = variant === 'row' ? 200 : 150,
	showTags = false,
	headingLevel = 'h3',
} = Astro.props;

const Heading = headingLevel;
const tags = showTags ? visibleTags(post.data.tags).slice(0, 4) : [];
const blurb = excerpt(post.body, excerptLength) || post.data.description;
const minutes = minutesToRead(post.body);
---

<a class:list={['post', variant]} href={`/blog/${post.id}/`}>
	<p class="meta">
		<FormattedDate date={post.data.date} />
		<span class="dot" aria-hidden="true" />
		<span>{minutes} min read</span>
	</p>
	<div class="body">
		<Heading>{post.data.title}</Heading>
		<p class="desc">{blurb}</p>
		<div class="foot">
			{tags.length > 0 && (
				<ul class="tags" aria-label="Tags">
					{tags.map((t) => (
						<li>{t}</li>
					))}
				</ul>
			)}
			<span class="read">Read &rarr;</span>
		</div>
	</div>
</a>
<style>
	.post {
		display: flex;
		flex-direction: column;
		height: 100%;
		box-sizing: border-box;
		color: inherit;
		text-decoration: none;
	}
	.post:hover {
		text-decoration: none;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin: 0 0 0.6rem;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgb(var(--gray));
	}
	.dot::before {
		content: '\00b7';
	}
	h2,
	h3 {
		margin: 0 0 0.5rem;
		font-size: 1.2rem;
		line-height: 1.25;
		color: rgb(var(--black));
		transition: color 0.15s ease;
	}
	.post:hover h2,
	.post:hover h3 {
		color: var(--accent);
	}
	.desc {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 0.92rem;
		line-height: 1.5;
	}
	.foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-top: auto;
		padding-top: 0.9rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tags li {
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.15rem 0.55rem;
		border: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		border-radius: 999px;
	}
	.read {
		flex: 0 0 auto;
		margin-left: auto;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity 0.15s ease, transform 0.15s ease;
	}
	.post:hover .read,
	.post:focus-visible .read {
		opacity: 1;
		transform: none;
	}

	/* ---- card ---- */
	.card {
		padding: 1.35rem 1.4rem 1.3rem;
		border: 1px solid rgb(var(--gray-light));
		border-top: 3px solid var(--accent);
		border-radius: 14px;
		background: rgb(var(--surface));
		transition: border-color 0.15s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}
	.card:hover {
		border-color: var(--accent);
		box-shadow: 0 18px 36px -24px rgba(35, 55, 255, 0.4);
		transform: translateY(-2px);
	}
	.card .body {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	/* ---- row ---- */
	.row {
		display: grid;
		grid-template-columns: 10.5rem minmax(0, 1fr);
		gap: 0.5rem 2rem;
		padding: 1.6rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.row .meta {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.3rem;
		margin: 0.2rem 0 0;
	}
	.row .meta .dot {
		display: none;
	}
	.row .meta :global(time) {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: none;
		color: rgb(var(--black));
	}
	.row h2,
	.row h3 {
		font-size: 1.45rem;
		line-height: 1.2;
	}
	.row .desc {
		font-size: 0.98rem;
		line-height: 1.55;
	}
	.row .foot {
		padding-top: 0.8rem;
	}
	@media (max-width: 720px) {
		.row {
			grid-template-columns: 1fr;
			gap: 0.4rem;
			padding: 1.35rem 0;
		}
		.row .meta {
			flex-direction: row;
			align-items: center;
			gap: 0.5rem 0.75rem;
			margin: 0;
		}
		.row .meta .dot {
			display: inline;
		}
		.row .meta :global(time) {
			font-family: var(--font-body);
			font-size: 0.78rem;
			font-weight: 400;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: rgb(var(--gray));
		}
		.row h2,
		.row h3 {
			font-size: 1.25rem;
		}
		.read {
			display: none;
		}
	}
</style>
