---
import { SITE_META_DESCRIPTION, SITE_TITLE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer>
	<div class="inner">
		<div class="brand-col">
			<a href="/" class="brand">
				<img src="/favicon.png" alt="" width="36" height="36" />
				<span>{SITE_TITLE}</span>
			</a>
			<p class="blurb">{SITE_META_DESCRIPTION}</p>
			<SocialLinks size={24} />
		</div>
		<nav class="col" aria-labelledby="footer-explore">
			<h2 id="footer-explore">Explore</h2>
			<ul>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/tags">Tags</a></li>
				<li><a href="/projects">Projects</a></li>
				<li><a href="/training">Training</a></li>
				<li><a href="/about">About</a></li>
			</ul>
		</nav>
		<nav class="col" aria-labelledby="footer-meta">
			<h2 id="footer-meta">Under the bonnet</h2>
			<ul>
				<li><a href="/rss.xml">RSS feed</a></li>
				<li><a href="/llms.txt">llms.txt</a></li>
				<li><a href="https://github.com/hungovercoders/site" target="_blank" rel="noopener">Source on GitHub</a></li>
				<li><a href="/privacy">Privacy</a></li>
			</ul>
		</nav>
	</div>
	<p class="copyright">
		&copy; {today.getFullYear()} hungovercoders &middot; folk tales of working in tech from the South Wales valleys &middot; Cheers, fellow hungovercoder.
	</p>
</footer>
<style>
	footer {
		margin-top: 4rem;
		padding: 3rem 1em 3.5rem;
		border-top: 1px solid rgb(var(--gray-light));
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
	}
	.inner {
		width: 1100px;
		max-width: 100%;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
		gap: 2.5rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: rgb(var(--black));
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.15rem;
		text-decoration: none;
	}
	.brand img {
		border-radius: 8px;
	}
	[data-theme='dark'] .brand img {
		filter: invert(1);
	}
	.blurb {
		margin: 1rem 0 1.25rem;
		max-width: 28rem;
		font-size: 0.95rem;
		line-height: 1.6;
	}
	.col h2 {
		margin: 0 0 0.9rem;
		font-family: var(--font-body);
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: rgb(var(--gray));
	}
	.col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.col a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.95rem;
	}
	.col a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.copyright {
		width: 1100px;
		max-width: 100%;
		margin: 2.5rem auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(var(--gray-light));
		font-size: 0.85rem;
	}
	@media (max-width: 720px) {
		footer {
			margin-top: 2.5rem;
			padding: 2.25rem 1em 2.5rem;
		}
		.inner {
			grid-template-columns: 1fr 1fr;
			gap: 2rem 1.5rem;
		}
		.brand-col {
			grid-column: 1 / -1;
		}
		.copyright {
			margin-top: 2rem;
			text-align: center;
		}
	}
</style>
