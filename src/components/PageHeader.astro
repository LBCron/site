---
// Standard page intro: an accent eyebrow, the title, an optional lead and
// an optional action link on the right. Matches the section heads on the
// home page so every listing page reads as part of the same site.
interface Props {
	eyebrow?: string;
	title: string;
	lead?: string;
	actionHref?: string;
	actionLabel?: string;
	lowercase?: boolean;
}

const { eyebrow, title, lead, actionHref, actionLabel, lowercase = false } = Astro.props;
---

<header class="page-header">
	<div>
		{eyebrow && <p class="eyebrow">{eyebrow}</p>}
		<h1 class:list={{ lowercase }}>{title}</h1>
		{lead && <p class="lead">{lead}</p>}
		<slot />
	</div>
	{actionHref && actionLabel && (
		<a class="more" href={actionHref}>{actionLabel} &rarr;</a>
	)}
</header>
<style>
	.page-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1.5rem;
		margin: 0.5rem 0 2.5rem;
		padding-bottom: 1.75rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--accent);
	}
	.eyebrow::before {
		content: '';
		width: 1.5rem;
		height: 2px;
		background: var(--accent);
		border-radius: 2px;
	}
	h1 {
		margin: 0;
		font-size: clamp(2.25rem, 5vw, 3rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}
	h1.lowercase {
		text-transform: lowercase;
	}
	.lead {
		margin: 0.75rem 0 0;
		max-width: 38rem;
		color: rgb(var(--gray));
		font-size: 1.05rem;
		line-height: 1.55;
	}
	.more {
		flex: 0 0 auto;
		color: var(--accent);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 700;
		white-space: nowrap;
		padding-bottom: 0.25rem;
	}
	.more:hover {
		text-decoration: underline;
	}
	@media (max-width: 720px) {
		.page-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
			margin-bottom: 2rem;
			padding-bottom: 1.25rem;
		}
	}
</style>
