---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
	);
	const link = (p?: CollectionEntry<'blog'>) =>
		p ? { title: p.data.title, href: `/blog/${p.id}/` } : undefined;
	return posts.map((post, i) => ({
		params: { slug: post.id },
		// posts are newest first, so the "next" post is the one published after
		props: { post, newer: link(posts[i - 1]), older: link(posts[i + 1]) },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	newer?: { title: string; href: string };
	older?: { title: string; href: string };
}

const { post, newer, older } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
---

<BlogPost
	{...post.data}
	headings={headings}
	minutesRead={remarkPluginFrontmatter.minutesRead}
	newer={newer}
	older={older}
>
	<Content />
</BlogPost>
