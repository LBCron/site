---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE_TITLE } from '../../consts';

const all = await getCollection('projects');

type Project = (typeof all)[number];
type Status = 'live' | 'wip' | 'archived';

const sortGroup = (a: Project, b: Project) => {
	const oa = a.data.order ?? 9999;
	const ob = b.data.order ?? 9999;
	if (oa !== ob) return oa - ob;
	return b.data.started.valueOf() - a.data.started.valueOf();
};

const byStatus: Record<Status, Project[]> = {
	live: all.filter((p) => p.data.status === 'live').sort(sortGroup),
	wip: all.filter((p) => p.data.status === 'wip').sort(sortGroup),
	archived: all.filter((p) => p.data.status === 'archived').sort(sortGroup),
};

const groupTitles: Record<Status, string> = {
	live: 'Live',
	wip: 'Work in progress',
	archived: 'Archived',
};

const groupLeads: Record<Status, string> = {
	live: 'On the internet and in use. Click through to try them.',
	wip: 'Being built in the evenings. Repos are open where there is one.',
	archived: 'Served their purpose. Kept for the record.',
};

const hostFromUrl = (url: string) => {
	try {
		return new URL(url).host.replace(/^www\./, '');
	} catch {
		return url;
	}
};

const started = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects | ${SITE_TITLE}`}
			description="Apps and tools dataGriff has built — live, in progress, and archived."
		/>
		<style>
			main {
				width: 1100px;
				max-width: calc(100% - 2em);
				padding-top: 1.5em;
			}
			.group {
				margin-bottom: 3.5rem;
			}
			.group-head {
				display: flex;
				align-items: baseline;
				gap: 1rem;
				margin-bottom: 1.25rem;
			}
			.group-head h2 {
				margin: 0;
				font-size: 1.5rem;
			}
			.group-head p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.25rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.card {
				display: block;
				height: 100%;
				box-sizing: border-box;
				padding: 1.5rem 1.6rem;
				background: rgb(var(--surface));
				border: 1px solid rgb(var(--gray-light));
				border-left: 4px solid var(--accent);
				border-radius: 14px;
				text-decoration: none;
				color: inherit;
				transition: border-color 0.15s ease, box-shadow 0.2s ease, transform 0.2s ease;
			}
			.card.wip {
				border-left-color: #d97706;
			}
			.card.archived {
				border-left-color: rgb(var(--gray));
			}
			a.card:hover {
				border-color: var(--accent);
				box-shadow: 0 18px 36px -24px rgba(35, 55, 255, 0.4);
				transform: translateY(-2px);
				text-decoration: none;
			}
			.card-head {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				gap: 1rem;
				margin-bottom: 0.35rem;
			}
			.card h3 {
				margin: 0;
				font-size: 1.3rem;
				line-height: 1.25;
				color: rgb(var(--black));
				transition: color 0.15s ease;
			}
			a.card:hover h3 {
				color: var(--accent);
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem 0.75rem;
				margin: 0 0 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: rgb(var(--gray));
			}
			.card .desc {
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
				line-height: 1.5;
			}
			.badge {
				flex: 0 0 auto;
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				padding: 0.2rem 0.6rem;
				border-radius: 999px;
				font-weight: 700;
				white-space: nowrap;
			}
			.badge.live {
				background: rgba(35, 55, 255, 0.1);
				color: var(--accent);
			}
			.badge.wip {
				background: rgba(217, 119, 6, 0.12);
				color: #92400e;
			}
			.badge.archived {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray));
			}
			[data-theme='dark'] .badge.wip {
				color: #fbbf24;
			}
			[data-theme='dark'] .badge.live {
				background: rgba(138, 150, 255, 0.16);
			}
			.foot {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				margin-top: 0.95rem;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.3rem;
			}
			.tag {
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				padding: 0.15rem 0.55rem;
				border: 1px solid rgb(var(--gray-light));
				color: rgb(var(--gray));
				border-radius: 999px;
			}
			.repo-link {
				flex: 0 0 auto;
				font-size: 0.85rem;
				font-weight: 700;
				color: var(--accent);
				text-decoration: none;
			}
			.repo-link:hover {
				text-decoration: underline;
			}
			.empty {
				border: 1px dashed rgb(var(--gray-light));
				border-radius: 14px;
				padding: 2rem;
				text-align: center;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				main {
					padding-top: 0.5em;
				}
				.group {
					margin-bottom: 2.5rem;
				}
				.group-head {
					flex-direction: column;
					gap: 0.25rem;
				}
				.grid {
					grid-template-columns: 1fr;
				}
				.card {
					padding: 1.25rem 1.3rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<PageHeader
				eyebrow="Built alongside the writing"
				title="Projects"
				lead="Apps and tools, each small enough to run cheaply and simple enough for one slightly hungover person to deploy."
				actionHref="https://github.com/hungovercoders"
				actionLabel="GitHub org"
			/>

			{
				(['live', 'wip', 'archived'] as Status[]).map((status) => {
					const list = byStatus[status];
					if (list.length === 0) return null;
					return (
						<section class="group" aria-labelledby={`group-${status}`}>
							<div class="group-head">
								<h2 id={`group-${status}`}>{groupTitles[status]}</h2>
								<p>{groupLeads[status]}</p>
							</div>
							<ul class="grid">
								{list.map((p) => {
									const isLink = status === 'live' && Boolean(p.data.url);
									const Inner = (
										<>
											<div class="card-head">
												<h3>{p.data.title}</h3>
												<span class={`badge ${status}`}>{groupTitles[status]}</span>
											</div>
											<p class="meta">
												{p.data.url && <span>{hostFromUrl(p.data.url)}</span>}
												<span>since {started(p.data.started)}</span>
											</p>
											<p class="desc">{p.data.description}</p>
											{((p.data.tags && p.data.tags.length > 0) || (p.data.repo && !isLink)) && (
												<div class="foot">
													<div class="tags">
														{(p.data.tags ?? []).map((t) => (
															<span class="tag">{t}</span>
														))}
													</div>
													{p.data.repo && !isLink && (
														<a class="repo-link" href={p.data.repo} target="_blank" rel="noopener">
															View repo &rarr;
														</a>
													)}
												</div>
											)}
										</>
									);
									return (
										<li>
											{isLink ? (
												<a class={`card ${status}`} href={p.data.url!} target="_blank" rel="noopener">
													{Inner}
												</a>
											) : (
												<div class={`card ${status}`}>{Inner}</div>
											)}
										</li>
									);
								})}
							</ul>
						</section>
					);
				})
			}

			{all.length === 0 && (
				<div class="empty">
					<h2>Nothing here yet</h2>
					<p>The portfolio is being seeded. Check back soon, fellow hungovercoder.</p>
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>
