---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE_TITLE } from '../../consts';
import { tagSlug } from '../../utils/posts';

const posts = await getCollection('blog');
// Merge tags case-insensitively (Azure/azure) to match the tag routes,
// keeping the lower-cased label so the cloud reads consistently.
const counts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags ?? []) {
		const key = tag.toLowerCase();
		if (key === 'hungovercoders') continue;
		counts.set(key, (counts.get(key) ?? 0) + 1);
	}
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const max = tags[0]?.[1] ?? 1;
// Four size tiers so the cloud shows what the blog is really about.
const tier = (count: number) => {
	const r = count / max;
	if (r >= 0.66) return 'xl';
	if (r >= 0.4) return 'lg';
	if (r >= 0.2) return 'md';
	return 'sm';
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tags | ${SITE_TITLE}`} description="Every topic written about on hungovercoders." />
		<style>
			main {
				width: 1100px;
				max-width: calc(100% - 2em);
				padding-top: 1.5em;
			}
			.tag-cloud {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.7rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.tag-cloud a {
				display: inline-flex;
				align-items: baseline;
				gap: 0.5rem;
				padding: 0.55rem 1.05rem;
				background: rgb(var(--surface));
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				color: rgb(var(--gray-dark));
				text-decoration: none;
				transition: border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
			}
			.tag-cloud a:hover {
				border-color: var(--accent);
				color: var(--accent);
				transform: translateY(-1px);
				text-decoration: none;
			}
			.tag-cloud .count {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: rgb(var(--gray));
			}
			.tag-cloud .xl {
				font-size: 1.45rem;
				font-family: var(--font-display);
				font-weight: 700;
				color: rgb(var(--black));
				border-color: rgba(35, 55, 255, 0.35);
			}
			.tag-cloud .lg {
				font-size: 1.2rem;
				font-family: var(--font-display);
				font-weight: 700;
				color: rgb(var(--black));
			}
			.tag-cloud .md {
				font-size: 1rem;
			}
			.tag-cloud .sm {
				font-size: 0.9rem;
			}
			@media (max-width: 720px) {
				main {
					padding-top: 0.5em;
				}
				.tag-cloud {
					gap: 0.5rem;
				}
				.tag-cloud .xl {
					font-size: 1.25rem;
				}
				.tag-cloud .lg {
					font-size: 1.1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<PageHeader
				eyebrow="Browse by topic"
				title="Tags"
				lead={`${tags.length} topics across ${posts.length} posts. The bigger the tag, the more often it comes up.`}
				actionHref="/blog"
				actionLabel="All posts"
			/>
			<ul class="tag-cloud">
				{tags.map(([tag, count]) => (
					<li>
						<a class={tier(count)} href={`/tags/${tagSlug(tag)}/`}>
							{tag}
							<span class="count">{count}</span>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
