---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE } from '../../consts';
import { shareImage, tagSlug } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const grouped = new Map<string, { display: string; posts: typeof posts }>();
	for (const post of posts) {
		for (const tag of post.data.tags ?? []) {
			if (tag.toLowerCase() === 'hungovercoders') continue;
			const slug = tagSlug(tag);
			if (!grouped.has(slug)) grouped.set(slug, { display: tag, posts: [] });
			grouped.get(slug)!.posts.push(post);
		}
	}
	return [...grouped.entries()].map(([slug, { display, posts }]) => ({
		params: { tag: slug },
		props: {
			display,
			posts: posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
		},
	}));
}

const { display, posts } = Astro.props;
const images = await Promise.all(posts.map((p) => shareImage(p.data.image?.path)));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${display} | ${SITE_TITLE}`}
			description={`Posts tagged ${display} on hungovercoders.`}
		/>
		<style>
			main {
				width: 1100px;
				max-width: calc(100% - 2em);
				padding-top: 1.5em;
			}
			.posts {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			@media (max-width: 960px) {
				.posts {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (max-width: 720px) {
				main {
					padding-top: 0.5em;
				}
				.posts {
					grid-template-columns: 1fr;
					gap: 1.25rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<PageHeader
				eyebrow="Tag"
				title={`#${display}`}
				lowercase
				lead={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged ${display.toLowerCase()}.`}
				actionHref="/tags"
				actionLabel="All tags"
			/>
			<ul class="posts">
				{posts.map((post, i) => (
					<li>
						<PostCard
							post={post}
							image={images[i]}
							showTags
							headingLevel="h2"
							loading={i < 3 ? 'eager' : 'lazy'}
						/>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
