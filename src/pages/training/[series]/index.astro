---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const allLessons = await getCollection('training');
	const seriesSet = [...new Set(allLessons.map((l) => l.data.series))];
	return seriesSet.map((s) => ({
		params: { series: s },
		props: {
			lessons: allLessons
				.filter((l) => l.data.series === s)
				.sort((a, b) => a.data.order - b.data.order),
		},
	}));
}

interface Props {
	lessons: CollectionEntry<'training'>[];
}

function lessonSlug(entry: CollectionEntry<'training'>) {
	return entry.id.split('/').at(-2)!;
}

const { series } = Astro.params;
const { lessons } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${series} | Training | ${SITE_TITLE}`}
			description={`${lessons.length} lessons in the ${series} series.`}
		/>
		<style>
			main {
				width: 880px;
				max-width: calc(100% - 2em);
				padding-top: 1.5em;
			}
			main :global(h1) {
				text-transform: capitalize;
			}
			.lessons {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}
			.lessons a {
				display: grid;
				grid-template-columns: auto 1fr auto;
				gap: 1.25rem;
				align-items: center;
				padding: 1.1rem 1.4rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				background: rgb(var(--surface));
				text-decoration: none;
				color: inherit;
				transition: border-color 0.15s ease, box-shadow 0.2s ease, transform 0.2s ease;
			}
			.lessons a:hover {
				border-color: var(--accent);
				box-shadow: 0 18px 36px -24px rgba(35, 55, 255, 0.4);
				transform: translateY(-2px);
				text-decoration: none;
			}
			.num {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				letter-spacing: 0.1em;
				color: var(--accent);
			}
			.lessons h2 {
				margin: 0 0 0.2rem;
				font-size: 1.15rem;
				line-height: 1.3;
				color: rgb(var(--black));
			}
			.lessons a:hover h2 {
				color: var(--accent);
			}
			.lessons p {
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 0.92rem;
				line-height: 1.5;
			}
			.arrow {
				color: rgb(var(--gray));
				font-size: 1.1rem;
			}
			.lessons a:hover .arrow {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				main {
					padding-top: 0.5em;
				}
				.lessons a {
					grid-template-columns: auto 1fr;
					gap: 0.9rem;
					padding: 1rem 1.1rem;
				}
				.arrow {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<PageHeader
				eyebrow="Training series"
				title={series!}
				lead={`${lessons.length} ${lessons.length === 1 ? 'lesson' : 'lessons'}, in order. Start at the top and work down.`}
				actionHref="/training"
				actionLabel="All series"
			/>
			<ol class="lessons">
				{
					lessons.map((lesson) => (
						<li>
							<a href={`/training/${lesson.data.series}/${lessonSlug(lesson)}/`}>
								<span class="num">{pad(lesson.data.order)}</span>
								<div>
									<h2>{lesson.data.title}</h2>
									<p>{lesson.data.description}</p>
								</div>
								<span class="arrow" aria-hidden="true">&rarr;</span>
							</a>
						</li>
					))
				}
			</ol>
		</main>
		<Footer />
	</body>
</html>
